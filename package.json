{
  "name": "namaz-vakti",
  "productName": "Muvakkit",
  "version": "1.2.0",
  "description": "Çalışırken namaz vakitlerini sessizce gösteren, reklamsız ve ücretsiz masaüstü uygulaması",
  "author": "Maşuk",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/masukcevik/muvakkit",
  "repository": {
    "type": "git",
    "url": "https://github.com/masukcevik/muvakkit.git"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "adhan": "^4.4.6",
    "koffi": "^3.3.6"
  },
  "devDependencies": {
    "electron": "45.2.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.namazvakti.app",
    "productName": "Muvakkit",
    "copyright": "Copyright (C) 2026 Maşuk — GPL-3.0-or-later",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE"
    ],
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/@koromix/**"
    ],
    "electronLanguages": [
      "tr",
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Muvakkit-Windows-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerLanguages": [
        "tr_TR"
      ],
      "language": "1055",
      "artifactName": "Muvakkit-Kurulum-${version}.${ext}",
      "createStartMenuShortcut": true,
      "shortcutName": "Muvakkit"
    },
    "appx": {
      "applicationId": "NamazVakti",
      "displayName": "Muvakkit",
      "languages": [
        "tr-TR"
      ],
      "addAutoLaunchExtension": true,
      "backgroundColor": "#170E0F",
      "artifactName": "Muvakkit-Store-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.lifestyle",
      "extendInfo": {
        "LSUIElement": true
      },
      "artifactName": "Muvakkit-macOS-${version}-${arch}.${ext}"
    }
  }
}
